<?xml version="1.0"?>
<Crm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Country="AE" Name="FS Advisory AutoSync" Version="8" SupportsEmojis="false" SupportsTranscription="true" ListPageSize="0">
  <Number Prefix="Zeros" MaxLength="15" />
  <Connection MaxConcurrentRequests="8" />
  <Parameters>
    <Parameter Name="ServerUrl" Type="String" Parent="Settings" Editor="String" Title="CRM Base URL:" Validation="" Default="https://api.fsadvisory.ae" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ReportCallEnabled" Type="Boolean" Parent="Call Reporting" Editor="String" Title="Enable Call Journaling?" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
  </Parameters>
  <Authentication Type="No" />
  <Scenarios>
    <Scenario Id="" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="" Url="[ServerUrl]/api/3cx/lookup?Number=[Number]" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="UrlEncoded" RequestType="Get" ResponseType="Json" />
      <Rules>
        <Rule Type="Any" Ethalon="">contact.id</Rule>
      </Rules>
      <Variables>
        <Variable Name="ContactID" LookupValue="" Path="contact.id"><Filter /></Variable>
        <Variable Name="FirstName" LookupValue="" Path="contact.first_name"><Filter /></Variable>
        <Variable Name="LastName" LookupValue="" Path="contact.last_name"><Filter /></Variable>
        <Variable Name="CompanyName" LookupValue="" Path="contact.company"><Filter /></Variable>
        <Variable Name="Phone" LookupValue="" Path="contact.phone"><Filter /></Variable>
        <Variable Name="Email" LookupValue="" Path="contact.email"><Filter /></Variable>
        <Variable Name="ContactUrl" LookupValue="" Path="contact.url"><Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="false">
        <Output Type="FirstName" Passes="0" Value="[FirstName]" />
        <Output Type="LastName" Passes="0" Value="[LastName]" />
        <Output Type="CompanyName" Passes="0" Value="[CompanyName]" />
        <Output Type="PhoneMobile" Passes="0" Value="[Phone]" />
        <Output Type="PhoneBusiness" Passes="0" Value="[Phone]" />
        <Output Type="Email" Passes="0" Value="[Email]" />
        <Output Type="EntityId" Passes="0" Value="[ContactID]" />
        <Output Type="EntityType" Passes="0" Value="Contacts" />
        <Output Type="ContactUrl" Passes="0" Value="[ContactUrl]" />
      </Outputs>
    </Scenario>
    <Scenario Id="ReportCall" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="[ReportCallEnabled]!=True" Url="[ServerUrl]/api/3cx/call-event" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="Json" RequestType="Post" ResponseType="Json">
        <PostValues Key="" If="" SkipIf="">
          <Value Key="CallId" If="" SkipIf="" Passes="0" Type="String">[CallId]</Value>
          <Value Key="AgentExtension" If="" SkipIf="" Passes="0" Type="String">[Agent]</Value>
          <Value Key="CallerNumber" If="" SkipIf="" Passes="0" Type="String">[Number]</Value>
          <Value Key="Direction" If="" SkipIf="" Passes="0" Type="String">[CallType]</Value>
          <Value Key="Duration" If="" SkipIf="" Passes="0" Type="Integer">[Duration]</Value>
          <Value Key="RecordingUrl" If="" SkipIf="" Passes="0" Type="String">[RecordingUrl]</Value>
          <Value Key="RecordingFile" If="" SkipIf="" Passes="0" Type="String">[RecordingFileName]</Value>
          <Value Key="CallStartTime" If="" SkipIf="" Passes="0" Type="String">[CallStartTimeLocal]</Value>
          <Value Key="CallNotes" If="" SkipIf="" Passes="0" Type="String">3CX Call logged automatically from extension [Agent]</Value>
        </PostValues>
      </Request>
      <Variables />
      <Outputs AllowEmpty="true" />
    </Scenario>
  </Scenarios>
</Crm>

